# Copy to .env and fill in what you have. Every value is optional:
# without keys the app starts in text and replay mode.

# Sarvam speech-to-text and text-to-speech (https://indus.sarvam.ai)
SARVAM_API_KEY=

# Gemini, used only to answer unexpected questions, fenced to the loan's own numbers (https://aistudio.google.com)
GOOGLE_API_KEY=

# Twilio, for real phone calls to Indian mobiles
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Public https address of this app, so Twilio can reach it (for example a Cloudflare tunnel)
PUBLIC_BASE_URL=
# Calls stay off unless this is true
CALLS_ENABLED=false
# Optional passcode for the hosted demo's call button
JUDGE_TOKEN=
